page {
  background: #f6f7f9;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 24rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.5;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.button {
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 84rpx;
}

.button::after {
  border: none;
}

.primary {
  background: #111827;
  color: #ffffff;
}

.secondary {
  background: #eef2f7;
  color: #111827;
}

.danger-btn {
  background: #ffffff;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}

.muted {
  color: #6b7280;
}

.meta {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.list-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.list-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.list-item:first-child {
  padding-top: 0;
}

.badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #374151;
  font-size: 22rpx;
  flex-shrink: 0;
}

.badge-success {
  background: #ecfdf5;
  color: #047857;
}

.badge-warn {
  background: #fffbeb;
  color: #b45309;
}

.badge-danger {
  background: #fef2f2;
  color: #b91c1c;
}

.badge-muted {
  background: #f3f4f6;
  color: #6b7280;
}

/* 热搜标签 */
.label-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  vertical-align: middle;
}

.label-boom {
  background: #fee2e2;
  color: #dc2626;
}

.label-hot {
  background: #ffedd5;
  color: #ea580c;
}

.label-new {
  background: #dbeafe;
  color: #2563eb;
}

.label-plain {
  background: #f3f4f6;
  color: #6b7280;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #374151;
  font-size: 26rpx;
}

.input {
  width: 100%;
  min-height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #d1d5db;
  border-radius: 10rpx;
  background: #ffffff;
  font-size: 28rpx;
}

/* 可选中的胶囊选项 */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d1d5db;
  background: #ffffff;
  color: #374151;
  font-size: 26rpx;
}

.chip-active {
  border-color: #111827;
  background: #111827;
  color: #ffffff;
}

/* 统计卡片 */
.stat-grid {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 22rpx 8rpx;
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

/* 顶部筛选 tab */
.tab-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tab {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  color: #6b7280;
  font-size: 26rpx;
}

.tab-active {
  background: #111827;
  border-color: #111827;
  color: #ffffff;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}
