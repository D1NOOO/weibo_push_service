<view class="page">
  <view class="section">
    <button class="button primary block-btn" bindtap="goCreate">新建订阅</button>
  </view>

  <view class="panel">
    <block wx:if="{{items.length}}">
      <view class="list-item" wx:for="{{items}}" wx:key="id">
        <view class="row">
          <view class="grow" bindtap="goEdit" data-id="{{item.id}}">
            <view class="sub-name">{{item.name}}</view>
            <view class="meta">{{item.keywordsText}}</view>
            <view class="meta">
              <text wx:if="{{item.labelsText}}">标签 {{item.labelsText}} · </text><text wx:if="{{item.minHotValue}}">热度 ≥ {{item.minHotValue}} · </text>{{item.channelCount ? item.channelCount + " 个通道" : "全部通道"}}
            </view>
          </view>
          <switch checked="{{item.enabled}}" color="#111827" data-id="{{item.id}}" bindchange="onToggle" />
        </view>
      </view>
    </block>
    <view wx:elif="{{loaded}}" class="empty">还没有订阅规则，点上方按钮创建第一条。</view>
    <view wx:else class="empty">加载中…</view>
  </view>
</view>
