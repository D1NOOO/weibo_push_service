.calc-page {
  display: flex;
  flex-direction: column;
}

.calc-display {
  margin-bottom: 24rpx;
  text-align: right;
  padding: 36rpx 32rpx;
}

.calc-expression {
  min-height: 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.calc-screen {
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1.2;
  word-break: break-all;
}

.calc-keys {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.calc-row {
  display: flex;
  gap: 16rpx;
}

.calc-key {
  flex: 1;
  height: 112rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #111827;
}

.calc-key-hover {
  transform: scale(0.95);
  background: #f3f4f6;
}

.calc-key-primary {
  background: #111827;
  border-color: #111827;
  color: #ffffff;
}

.calc-key-danger {
  color: #dc2626;
}
